<Window x:Class="MightyRadio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mighty Radio" Icon="Assets/MightyRadio.ico"
        Width="1040" Height="760" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="15"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
            <Image Source="Assets/MightyRadio.ico" Width="34" Height="34" Margin="0,0,10,0"/>
            <TextBlock Text="Mighty Radio" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Now playing panel -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock x:Name="StatusLabel" Text="READY" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="StationNameText" Text="Choose a station below" FontSize="24" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock x:Name="NowPlayingText" Text="" FontSize="16" Foreground="{StaticResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    <TextBlock x:Name="MessageText" Text="" FontSize="14" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Volume -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="Volume" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="VolumeText" Text="70" Width="34" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}"/>
                </StackPanel>

                <!-- Main controls -->
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Click="PlayButton_Click" MinWidth="110"
                            ToolTip="Play the station shown above">
                        <TextBlock Text="▶  Play" Foreground="{StaticResource AccentTextBrush}"/>
                    </Button>
                    <Button x:Name="StopButton" Click="StopButton_Click" MinWidth="110" ToolTip="Stop playing">
                        <TextBlock Text="■  Stop"/>
                    </Button>
                    <Button x:Name="RecordButton" Click="RecordButton_Click" MinWidth="150"
                            ToolTip="Save what you are hearing to Music\MightyRadio">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="RecordDot" Width="12" Height="12" Fill="{StaticResource RecordBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RecordButtonText" Text="Record"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FavouriteButton" Click="FavouriteButton_Click" MinWidth="190"
                            ToolTip="Add or remove this station from your favourites">
                        <TextBlock x:Name="FavouriteButtonText" Text="☆  Add to favourites"/>
                    </Button>
                    <Button x:Name="OpenRecordingsButton" Click="OpenRecordingsButton_Click"
                            ToolTip="Open the folder where recordings are saved">
                        <TextBlock Text="Recordings folder"/>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,14,0,0">

            <!-- Radio stations -->
            <TabItem Header="Radio stations">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Station name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NameBox" KeyDown="SearchBox_KeyDown" ToolTip="Part of the station name, e.g. BBC"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Country" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CountryBox" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Genre (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TagBox" KeyDown="SearchBox_KeyDown" ToolTip="e.g. jazz, rock, news, classical"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="Sort by" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SortBox"/>
                        </StackPanel>
                        <Button x:Name="SearchButton" Grid.Column="4" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom"
                                Margin="0" MinWidth="110" Click="SearchButton_Click">
                            <TextBlock Text="Search" Foreground="{StaticResource AccentTextBrush}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ResultsList" ItemTemplate="{StaticResource StationTemplate}"
                                 MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"/>
                        <TextBlock x:Name="ResultsEmptyText" Text="Searching for stations…" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" FontSize="16"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="30" IsHitTestVisible="False"/>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Click="PlaySelectedResult_Click" Style="{StaticResource AccentButton}">
                            <TextBlock Text="▶  Play selected" Foreground="{StaticResource AccentTextBrush}"/>
                        </Button>
                        <Button Click="AddSelectedResultToFavourites_Click">
                            <TextBlock Text="☆  Add to favourites"/>
                        </Button>
                        <TextBlock x:Name="ResultsCountText" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="13" Text="Tip: double-click a station to play it"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Scanner -->
            <TabItem Header="Scanner">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Filter (name, place, notes)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ScannerFilterBox" TextChanged="ScannerFilter_Changed" ToolTip="e.g. tower, NOAA, police, morse"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ScannerCategoryBox" SelectionChanged="ScannerFilter_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Click="EditScannerList_Click" ToolTip="Open the feed list in Notepad so you can add your own">
                                <TextBlock Text="Edit list"/>
                            </Button>
                            <Button Click="ReloadScannerList_Click" Margin="0" ToolTip="Reload the feed list after editing">
                                <TextBlock Text="Reload"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ScannerList" ItemTemplate="{StaticResource StationTemplate}"
                                 MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"/>
                        <TextBlock x:Name="ScannerEmptyText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="16" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="30" IsHitTestVisible="False"/>
                    </Grid>

                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Click="PlaySelectedScanner_Click" Style="{StaticResource AccentButton}">
                            <TextBlock Text="▶  Play / open" Foreground="{StaticResource AccentTextBrush}"/>
                        </Button>
                        <Button Click="AddSelectedScannerToFavourites_Click">
                            <TextBlock Text="☆  Add to favourites"/>
                        </Button>
                        <TextBlock x:Name="ScannerCountText" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="13"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Favourites -->
            <TabItem Header="Favourites">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="FavouritesList" ItemTemplate="{StaticResource StationTemplate}"
                             MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"/>
                    <TextBlock x:Name="FavouritesEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="30" IsHitTestVisible="False"
                               Text="No favourites yet. Find a station you like and press ☆ Add to favourites."/>
                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button Click="PlaySelectedFavourite_Click" Style="{StaticResource AccentButton}">
                            <TextBlock Text="▶  Play selected" Foreground="{StaticResource AccentTextBrush}"/>
                        </Button>
                        <Button Click="RemoveFavourite_Click">
                            <TextBlock Text="✕  Remove"/>
                        </Button>
                        <Button Click="MoveFavourite_Click" Tag="-1" ToolTip="Move up">
                            <TextBlock Text="▲"/>
                        </Button>
                        <Button Click="MoveFavourite_Click" Tag="1" ToolTip="Move down">
                            <TextBlock Text="▼"/>
                        </Button>
                        <TextBlock x:Name="FavouritesCountText" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="13"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Margin="2,10,0,0" FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                   Text="Station directory by radio-browser.info  ·  Scanner feeds from stations-scanner.json (editable)"/>
    </Grid>
</Window>
