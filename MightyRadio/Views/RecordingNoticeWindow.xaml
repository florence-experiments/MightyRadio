<Window x:Class="MightyRadio.Views.RecordingNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Before you record - Mighty Radio" Width="640" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="15" TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Readout}" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderText" Text="BEFORE YOU RECORD" FontSize="20" FontWeight="SemiBold"
                       Style="{StaticResource ReadoutText}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="18,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430" Focusable="False">
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" LineHeight="22"
                           AutomationProperties.Name="Recording notice"/>
            </ScrollViewer>
        </Border>

        <CheckBox x:Name="AcceptBox" Grid.Row="2" Margin="0,16,0,0" Content="I understand and accept"
                  Checked="AcceptBox_Changed" Unchecked="AcceptBox_Changed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ContinueButton" Style="{StaticResource AccentButton}" MinWidth="130" IsEnabled="False"
                    IsDefault="True" Click="Continue_Click" Content="Continue"/>
            <Button x:Name="CancelButton" MinWidth="110" Margin="0" IsCancel="True" Content="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
