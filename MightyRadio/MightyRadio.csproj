<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK TFM gives access to System Media Transport Controls (media keys + Windows media overlay). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MightyRadio</AssemblyName>
    <RootNamespace>MightyRadio</RootNamespace>
    <Product>Mighty Radio</Product>
    <AssemblyTitle>Mighty Radio</AssemblyTitle>
    <Description>Mighty Radio - simple internet radio and scanner player</Description>
    <Company>Mighty Radio</Company>
    <Copyright>Copyright (c) 2026 florence-experiments. MIT licence.</Copyright>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\MightyRadio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- No telemetry / diagnostics extras -->
    <EventSourceSupport>false</EventSourceSupport>
    <!-- Only bundle the 64-bit VLC engine (lands in libvlc\win-x64) -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Audio-only LibVLC: ship just the plugins needed for internet radio playback and recording
    (HTTP/HTTPS + TLS, ICY, PLS/M3U/HLS/DASH, MP3/AAC/HE-AAC/Ogg Vorbis/Opus/FLAC/WMA, Windows audio outputs,
    raw stream dump + TS mux for recording). Video, subtitles, discs, visualisations, Lua scripts and
    streaming servers are left out. To ship the full engine, delete this ItemGroup.
  -->
  <ItemGroup>
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll" />
    <!-- access: network input -->
    <VlcWindowsX64IncludeFiles Include="plugins\access\libhttp_plugin.dll;plugins\access\libhttps_plugin.dll;plugins\access\libidummy_plugin.dll" />
    <!-- TLS for https, XML for DASH manifests -->
    <VlcWindowsX64IncludeFiles Include="plugins\misc\libgnutls_plugin.dll;plugins\misc\libxml_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\keystore\%2A%2A;plugins\logger\%2A%2A" />
    <!-- stream filters: caching, prefetch, gzip, ID3 skip -->
    <VlcWindowsX64IncludeFiles Include="plugins\stream_filter\%2A%2A" />
    <!-- demuxers -->
    <VlcWindowsX64IncludeFiles Include="plugins\demux\libadaptive_plugin.dll;plugins\demux\libes_plugin.dll;plugins\demux\libogg_plugin.dll;plugins\demux\libmp4_plugin.dll;plugins\demux\libts_plugin.dll;plugins\demux\libplaylist_plugin.dll;plugins\demux\libasf_plugin.dll;plugins\demux\libmkv_plugin.dll;plugins\demux\libflacsys_plugin.dll;plugins\demux\libwav_plugin.dll;plugins\demux\librawaud_plugin.dll;plugins\demux\libnoseek_plugin.dll;plugins\demux\libdemuxdump_plugin.dll" />
    <!-- audio decoders (avcodec covers AAC/HE-AAC, WMA, AC3) -->
    <VlcWindowsX64IncludeFiles Include="plugins\codec\libavcodec_plugin.dll;plugins\codec\libmpg123_plugin.dll;plugins\codec\libvorbis_plugin.dll;plugins\codec\libopus_plugin.dll;plugins\codec\libflac_plugin.dll;plugins\codec\libspeex_plugin.dll;plugins\codec\libaraw_plugin.dll;plugins\codec\liblpcm_plugin.dll;plugins\codec\libg711_plugin.dll;plugins\codec\libadpcm_plugin.dll;plugins\codec\libspdif_plugin.dll;plugins\codec\libddummy_plugin.dll;plugins\codec\libedummy_plugin.dll" />
    <!-- packetizers for audio -->
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\libpacketizer_mpeg4audio_plugin.dll;plugins\packetizer\libpacketizer_mpegaudio_plugin.dll;plugins\packetizer\libpacketizer_flac_plugin.dll;plugins\packetizer\libpacketizer_dts_plugin.dll;plugins\packetizer\libpacketizer_mlp_plugin.dll;plugins\packetizer\libpacketizer_copy_plugin.dll" />
    <!-- audio pipeline + Windows outputs (spatial audio / HRTF left out) -->
    <VlcWindowsX64IncludeFiles Include="plugins\audio_filter\%2A%2A;plugins\audio_mixer\%2A%2A;plugins\audio_output\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\audio_filter\libspatialaudio_plugin.dll" />
    <!-- recording: stream output to a file -->
    <VlcWindowsX64IncludeFiles Include="plugins\stream_out\libstream_out_standard_plugin.dll;plugins\stream_out\libstream_out_duplicate_plugin.dll;plugins\stream_out\libstream_out_display_plugin.dll;plugins\stream_out\libstream_out_es_plugin.dll;plugins\stream_out\libstream_out_dummy_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\mux\libmux_ts_plugin.dll;plugins\mux\libmux_ogg_plugin.dll;plugins\mux\libmux_dummy_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\access_output\libaccess_output_file_plugin.dll;plugins\access_output\libaccess_output_dummy_plugin.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MightyRadio.ico" />
    <Content Include="stations-scanner.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Docs and licence texts travel with every build -->
    <Content Include="..\docs\README.txt" Link="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\licenses\LGPL-2.1.txt" Link="licenses\LGPL-2.1.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

</Project>
