<!-- Palette: Brass & Amber. Gunmetal panels, brass trim, an amber vacuum-fluorescent style readout. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1C1E21" Offset="0"/>
        <GradientStop Color="#111214" Offset="1"/>
    </LinearGradientBrush>
    <!-- Brushed gunmetal -->
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2D31" Offset="0"/>
        <GradientStop Color="#212327" Offset="0.5"/>
        <GradientStop Color="#1C1E21" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelAltBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#363A3F" Offset="0"/>
        <GradientStop Color="#2A2D31" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InputBrush" Color="#16171A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#3C3F44"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#4A3A1E"/>
    <LinearGradientBrush x:Key="BorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7A6440" Offset="0"/>
        <GradientStop Color="#4A3E2A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TextBrush" Color="#ECE3D0"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A89C84"/>
    <!-- Polished brass -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DDBB6E" Offset="0"/>
        <GradientStop Color="#B08D57" Offset="0.55"/>
        <GradientStop Color="#8C6D3C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EFD08A" Offset="0"/>
        <GradientStop Color="#C9A24A" Offset="0.55"/>
        <GradientStop Color="#A07E45" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1A1408"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#FFB000"/>
    <SolidColorBrush x:Key="RecordBrush" Color="#D9483B"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF9C7A"/>
    <SolidColorBrush x:Key="OkBrush" Color="#D8C27A"/>

    <!-- Amber readout -->
    <LinearGradientBrush x:Key="DisplayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1507" Offset="0"/>
        <GradientStop Color="#120C04" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DisplayBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C9A24A" Offset="0"/>
        <GradientStop Color="#6E5530" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DisplayTextBrush" Color="#FFB000"/>
    <SolidColorBrush x:Key="DisplaySubtleBrush" Color="#C78A12"/>
    <SolidColorBrush x:Key="DisplayStatusBrush" Color="#FFC94D"/>
    <FontFamily x:Key="DisplayFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <DropShadowEffect x:Key="DisplayGlow" ShadowDepth="0" BlurRadius="9" Opacity="0.55" Color="#FF9A00"/>

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#16171A"/>
    <LinearGradientBrush x:Key="ScrollThumbBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7A6440" Offset="0"/>
        <GradientStop Color="#9C7F4D" Offset="0.5"/>
        <GradientStop Color="#6E5A36" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollThumbHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B08D57" Offset="0"/>
        <GradientStop Color="#DDBB6E" Offset="0.5"/>
        <GradientStop Color="#9C7A45" Offset="1"/>
    </LinearGradientBrush>

    <CornerRadius x:Key="ControlCorner">3</CornerRadius>
    <CornerRadius x:Key="PanelCorner">4</CornerRadius>
    <CornerRadius x:Key="ItemCorner">2</CornerRadius>
</ResourceDictionary>
