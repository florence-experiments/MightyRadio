<!-- Palette: Phosphor. Near-black console with a green phosphor readout. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBrush" Color="#070B08"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0D1410"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#122019"/>
    <SolidColorBrush x:Key="InputBrush" Color="#08110C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#173024"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1C3A28"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1F3A2A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#C8F5D6"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6FA484"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#33E07A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5CFF8F"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#04140A"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#9CFFC0"/>
    <SolidColorBrush x:Key="RecordBrush" Color="#FF4D4D"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A7A"/>
    <SolidColorBrush x:Key="OkBrush" Color="#5CFF8F"/>

    <SolidColorBrush x:Key="DisplayBrush" Color="#031008"/>
    <SolidColorBrush x:Key="DisplayBorderBrush" Color="#1F5A36"/>
    <SolidColorBrush x:Key="DisplayTextBrush" Color="#5CFF8F"/>
    <SolidColorBrush x:Key="DisplaySubtleBrush" Color="#2FA35A"/>
    <SolidColorBrush x:Key="DisplayStatusBrush" Color="#9CFFC0"/>
    <FontFamily x:Key="DisplayFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <DropShadowEffect x:Key="DisplayGlow" ShadowDepth="0" BlurRadius="10" Opacity="0.6" Color="#33FF88"/>

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#08110C"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#1F5A36"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#33E07A"/>

    <CornerRadius x:Key="ControlCorner">2</CornerRadius>
    <CornerRadius x:Key="PanelCorner">2</CornerRadius>
    <CornerRadius x:Key="ItemCorner">1</CornerRadius>
</ResourceDictionary>
