<Window x:Class="MightyTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Mighty TV"
        Width="1100" Height="780" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="15"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="Root" Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="Auto"/>
            <RowDefinition x:Name="VideoRow" Height="2*" MinHeight="120"/>
            <RowDefinition x:Name="SplitterRow" Height="Auto"/>
            <RowDefinition x:Name="BrowserRow" Height="3*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Mighty TV" FontSize="25" FontWeight="Bold" Margin="2,0,0,10"/>

        <Border x:Name="VideoBorder" Grid.Row="1" Background="Black" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" ClipToBounds="True">
            <!-- Content sits in LibVLC's foreground window, so a click on the picture reaches WPF. -->
            <vlc:VideoView x:Name="Video" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Border Background="Transparent" Focusable="True"
                        MouseLeftButtonDown="VideoOverlay_MouseLeftButtonDown" KeyDown="VideoOverlay_KeyDown"/>
            </vlc:VideoView>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Row="2" Height="10" Margin="0,6"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="{DynamicResource AccentBrush}"
                      ToolTip="Drag to resize the picture"/>

        <Grid x:Name="Browser" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="14,12" Margin="0,4,0,0">
            <StackPanel>
                <Border Style="{StaticResource Readout}">
                    <StackPanel>
                        <TextBlock x:Name="StatusLabel" Text="LOADING" Style="{StaticResource ReadoutStatusText}"/>
                        <TextBlock x:Name="ChannelNameText" Text="Loading the channel directory…" FontSize="20" FontWeight="SemiBold"
                                   Style="{StaticResource ReadoutText}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MessageText" Text="" FontSize="14" Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlayButton" Style="{StaticResource AccentButton}" Content="_Play" Click="PlayButton_Click" MinWidth="104"/>
                        <Button x:Name="StopButton" Content="_Stop" Click="StopButton_Click" MinWidth="104"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Volume" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="VolumeSlider" Width="170" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center"
                                IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeText" Text="70" Width="34" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" KeyDown="NameBox_KeyDown" ToolTip="Part of a channel name"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Country" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CountryBox" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryBox" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                <CheckBox x:Name="AdultBox" Content="Adult" Margin="0,0,8,8" Checked="AdultBox_Changed" Unchecked="AdultBox_Changed"
                          ToolTip="Show channels iptv-org marks as adult"/>
                <Button Content="_Search" Click="SearchButton_Click" MinWidth="104"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Text="" Style="{StaticResource SubtleText}" Margin="2,6,0,0"/>
            <ListBox x:Name="ChannelList" MouseDoubleClick="ChannelList_MouseDoubleClick" KeyDown="ChannelList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,2">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Details}" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </Grid>
    </Grid>
</Window>
